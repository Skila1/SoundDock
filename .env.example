# SoundDock environment reference. Copy to .env and adjust.
# The installer generates secrets automatically.

SD_ROLE=all
SD_HTTP_ADDR=:8080
SD_PUBLIC_URL=http://localhost:8080
SD_INSTANCE_NAME=SoundDock
SD_TRUSTED_PROXIES=127.0.0.1/32,::1/128

SD_DATABASE_URL=postgres://sounddock:changeme@postgres:5432/sounddock?sslmode=disable
SD_MASTER_KEY=change-me-to-32-plus-random-bytes
SD_DATA_DIR=/data
SD_CACHE_DIR=/data/cache
SD_BACKUP_DIR=/data/backups
SD_MANAGED_DIR=/data/managed

SD_COOKIE_SECURE=false
SD_LOG_LEVEL=info
SD_OPENSUBSONIC=false
SD_METRICS_ENABLED=false
SD_METRICS_TOKEN=

# Optional Redis (compose profile: redis)
# SD_REDIS_URL=redis://redis:6379/0

# Optional Meilisearch (compose profile: search)
# SD_MEILISEARCH_URL=http://meilisearch:7700
# SD_MEILISEARCH_KEY=

# Optional Cloudflare Tunnel (compose profile: cloudflare)
# CLOUDFLARE_TUNNEL_TOKEN=

# Discord sign-in (optional). Set SD_DISCORD_ENABLED=false to use local username/password setup instead.
# Redirect URL: ${SD_PUBLIC_URL}/api/v1/auth/discord/callback
SD_DISCORD_ENABLED=true
SD_DISCORD_CLIENT_ID=
SD_DISCORD_CLIENT_SECRET=
# Optional: also seeds Admin → Discord bot token
# SD_DISCORD_BOT_TOKEN=
# Discord snowflake user ID that is administrator on every launch (comma-separated allowed)
SD_ADMIN_DISCORD_ID=

# Published image (install.sh pulls this). Local `docker compose up --build` still builds.
SD_IMAGE=ghcr.io/sounddock/sounddock:latest
SD_PORT=8080

POSTGRES_PASSWORD=changeme
POSTGRES_USER=sounddock
POSTGRES_DB=sounddock
