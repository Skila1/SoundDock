# SoundDock environment reference. Copy to .env and adjust.
# The installer generates secrets automatically.

SOUNDDOCK_ROLE=all
SOUNDDOCK_HTTP_ADDR=:8080
SOUNDDOCK_PUBLIC_URL=http://localhost:8080
SOUNDDOCK_INSTANCE_NAME=SoundDock
SOUNDDOCK_TRUSTED_PROXIES=127.0.0.1/32,::1/128

SOUNDDOCK_DATABASE_URL=postgres://sounddock:changeme@postgres:5432/sounddock?sslmode=disable
SOUNDDOCK_MASTER_KEY=change-me-to-32-plus-random-bytes
SOUNDDOCK_DATA_DIR=/data
SOUNDDOCK_CACHE_DIR=/data/cache
SOUNDDOCK_BACKUP_DIR=/data/backups
SOUNDDOCK_MANAGED_DIR=/data/managed

SOUNDDOCK_COOKIE_SECURE=false
SOUNDDOCK_LOG_LEVEL=info
SOUNDDOCK_OPENSUBSONIC=false
SOUNDDOCK_METRICS_ENABLED=false
SOUNDDOCK_METRICS_TOKEN=

# Optional Redis (compose profile: redis)
# SOUNDDOCK_REDIS_URL=redis://redis:6379/0

# Optional Meilisearch (compose profile: search)
# SOUNDDOCK_MEILISEARCH_URL=http://meilisearch:7700
# SOUNDDOCK_MEILISEARCH_KEY=

# Optional Cloudflare Tunnel (compose profile: cloudflare)
# CLOUDFLARE_TUNNEL_TOKEN=

# Discord sign-in (required). Create an application at https://discord.com/developers/applications
# Redirect URL: ${SOUNDDOCK_PUBLIC_URL}/api/v1/auth/discord/callback
SOUNDDOCK_DISCORD_CLIENT_ID=
SOUNDDOCK_DISCORD_CLIENT_SECRET=
# Optional: also seeds Admin → Discord bot token
# SOUNDDOCK_DISCORD_BOT_TOKEN=
# Discord snowflake user ID that is administrator on every launch (comma-separated allowed)
SOUNDDOCK_ADMIN_DISCORD_ID=

# Published image (install.sh pulls this). Local `docker compose up --build` still builds.
SOUNDDOCK_IMAGE=ghcr.io/sounddock/sounddock:latest
SOUNDDOCK_PORT=8080

POSTGRES_PASSWORD=changeme
POSTGRES_USER=sounddock
POSTGRES_DB=sounddock
