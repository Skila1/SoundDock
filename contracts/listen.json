{
  "play": {
    "threshold": "first of 30s or 50% of duration",
    "once_per_track_start": true,
    "pause_resumes_same_start": true,
    "seek_past_threshold_counts": true,
    "seek_back_after_counted_does_not_double": true,
    "repeat_one_loop_is_new_start": true,
    "stop_after_current_is_not_skip": true
  },
  "skip": {
    "when": "user next/prev before threshold",
    "effects": ["increment play_counts.skip_count", "do not increment play count", "do not insert listen_history"]
  },
  "listen_history_row": {
    "user_id": "00000000-0000-4000-8000-000000000001",
    "track_id": "00000000-0000-4000-8000-000000000050",
    "played_at": "2026-01-15T12:00:00Z",
    "duration_ms": 185000,
    "source": "web"
  },
  "sources": ["web", "discord", "import"],
  "wrapped_default_sources": ["web", "discord"],
  "post_progress": {
    "method": "POST",
    "path": "/api/v1/me/listen",
    "body": {
      "track_id": "00000000-0000-4000-8000-000000000050",
      "position_ms": 30000,
      "duration_ms": 185000,
      "source": "web",
      "event": "progress"
    }
  },
  "post_skip": {
    "method": "POST",
    "path": "/api/v1/me/listen",
    "body": {
      "track_id": "00000000-0000-4000-8000-000000000050",
      "position_ms": 5000,
      "duration_ms": 185000,
      "source": "web",
      "event": "skip"
    }
  }
}
